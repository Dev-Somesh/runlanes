{
  "name": "runlanes",
  "version": "0.5.2",
  "description": "See what your coding agents actually did — cost, concurrency, and which files each run touched. Reads local transcripts, sends nothing anywhere.",
  "type": "module",
  "bin": {
    "runlanes": "src/cli.js"
  },
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./sources": "./src/sources/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node --test test/*.test.js"
  },
  "keywords": [
    "ai-agents",
    "observability",
    "claude-code",
    "cursor",
    "developer-tools",
    "llm",
    "cli",
    "tracing",
    "agent-monitoring"
  ],
  "author": "Dev-Somesh <hello@someshbhardwaj.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-Somesh/runlanes.git"
  },
  "bugs": {
    "url": "https://github.com/Dev-Somesh/runlanes/issues"
  },
  "homepage": "https://github.com/Dev-Somesh/runlanes#readme"
}
